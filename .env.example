# GEMINI_API_KEY: Required for Gemini AI API calls (Server-side only).
# - Google Cloud Run / AI Studio: Injected automatically at runtime or configured via Secrets panel.
# - Vercel: Configure in Project Settings -> Environment Variables.
# NEVER prefix with VITE_ or expose to the frontend.
GEMINI_API_KEY=""

# GEMINI_MODEL: Model to use for AI calls (Default: gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: Host URL of the deployment
APP_URL=""
